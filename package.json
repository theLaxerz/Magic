    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "mongodb": "^6.3.0",
    "winston": "^3.11.0",
    "hpp": "^0.2.3",
    "xss-clean": "^0.1.4",
    "cookie-parser": "^1.4.6",
    "compression": "^1.7.4"
